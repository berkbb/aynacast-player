<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule as backup_rules.xml: the AirPlay identity and pairings stay on this TV. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="airplay_identity.xml" />
        <exclude domain="sharedpref" path="airplay_paired_devices.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="airplay_identity.xml" />
        <exclude domain="sharedpref" path="airplay_paired_devices.xml" />
    </device-transfer>
</data-extraction-rules>
